<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="93">
    <author>ubuntu811</author>
    <version>1.0.0.0</version>
    <title>
        <en>Immersive Weathering</en>
    </title>
    <description>
        <en>Adds realistic weed growth to gravel plots overnight.</en>
    </description>
    <iconFilename>icon_immersive_weathering.dds</iconFilename>
    <multiplayer supported="true"/>

    <!-- Not a hard requirement - IW works completely standalone (every
         WailaHud/g_currentMission read is nil-guarded with a fallback).
         Declared anyway because "works standalone" undersells it: without
         WAILA installed, IW's own HUD panels lose their left-edge anchor
         point and fall back to a fixed corner, and there's no live world
         inspector to pair with the tyre/foliage mechanics at all - the
         intended experience is genuinely the two together, not IW alone. -->
    <dependencies>
        <dependency>FS25_whatAmILookingAt</dependency>
    </dependencies>

    <extraSourceFiles>
        <sourceFile filename="scripts/ImmersiveWeathering.lua" />
    </extraSourceFiles>

    <actions>
        <!-- IW_PLACE_TEST_RIG and IW_FILL_AREA are retired for now, not
             just unbound - no action, no binding, no l10n. The underlying
             functions (placeFoliageTestRig, placeFoliageAreaFill) and their
             key-press handlers are untouched in the Lua, just no longer
             wired to an input action. Re-add all three pieces together to
             bring a debug key back. -->
        <action name="IW_WEATHER_CROSSHAIR" axisType="HALF"/>
        <action name="IW_RUN_SWEEP" axisType="HALF"/>
        <action name="IW_TOGGLE_SAMPLE_COUNT" axisType="HALF"/>
        <!-- No category attribute on any action below either: tried
             category="ONFOOT" and category="VEHICLE" through the global
             g_inputBinding registration path earlier, and also tried a
             fully per-vehicle Vehicle:onRegisterActionEvents +
             self:addActionEvent mechanism (the pattern real vehicle
             specializations use, confirmed against TerraFarm's own
             MACHINE_TOGGLE_ACTIVE) - that per-vehicle approach was flaky
             (isActiveForInput silently flipped false and wiped bindings)
             and was fully reverted. All six IW_* actions now register once
             globally via PlayerInputComponent.registerGlobalPlayerActionEvents
             and stay active identically on foot or in any vehicle; category
             is omitted everywhere so the engine's own ONFOOT/VEHICLE context
             switch can't silently deactivate them out from under us. No
             AI-exclude toggle - AI-driven vehicles are unconditionally
             excluded from tyre effects in the Lua, player-only by design,
             not an option. -->
        <action name="IW_TOGGLE_TYRE_EFFECTS" axisType="HALF"/>
        <action name="IW_CYCLE_WITHER_CHANCE" axisType="HALF"/>
        <action name="IW_TOGGLE_PAINT_BIAS" axisType="HALF"/>
    </actions>

    <inputBinding>
        <actionBinding action="IW_WEATHER_CROSSHAIR">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_h" index="1" />
        </actionBinding>
        <actionBinding action="IW_RUN_SWEEP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_n" index="1" />
        </actionBinding>
        <actionBinding action="IW_TOGGLE_SAMPLE_COUNT">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_i" index="1" />
        </actionBinding>
        <actionBinding action="IW_TOGGLE_TYRE_EFFECTS">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_t" index="1" />
        </actionBinding>
        <!-- Single-Shift+letter combos kept colliding with per-vehicle
             defaults all night (T flaky, Y dead, P clashed with a menu,
             now O/U clash with crab/all-wheel steering on this tractor).
             Confirmed via FS25_followme's own FOLLOW_CHASER_CHOOSE that a
             3-token chord (two modifiers + one key) is valid syntax, and
             far less likely to already be claimed by any vehicle. -->
        <actionBinding action="IW_CYCLE_WITHER_CHANCE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_b" index="1" />
        </actionBinding>
        <actionBinding action="IW_TOGGLE_PAINT_BIAS">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_v" index="1" />
        </actionBinding>
    </inputBinding>

    <l10n>
         <text name="input_IW_WEATHER_CROSSHAIR">
            <en>Weather Target</en>
        </text>
         <text name="input_IW_RUN_SWEEP">
            <en>Weathering Sweep</en>
        </text>
         <text name="input_IW_TOGGLE_SAMPLE_COUNT">
            <en>Sweep sample count</en>
        </text>
         <text name="input_IW_TOGGLE_TYRE_EFFECTS">
            <en>Tyre withering</en>
        </text>
         <text name="input_IW_CYCLE_WITHER_CHANCE">
            <en>Tyre withering weight</en>
        </text>
         <text name="input_IW_TOGGLE_PAINT_BIAS">
            <en>Tyre withering material</en>
        </text>
     </l10n>
</modDesc>
