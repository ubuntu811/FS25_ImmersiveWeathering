<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="93">
    <author>ubuntu811</author>
    <version>1.3.0.0</version>
    <title>
        <en>Immersive Weathering</en>
    </title>
    <description>
        <en>Adds realistic weed growth to gravel plots overnight.</en>
    </description>
    <iconFilename>icon_immersive_weathering.dds</iconFilename>
    <multiplayer supported="true"/>

    <!-- Not a hard requirement - IW works completely standalone (every
         WailaHud/g_currentMission read is nil-guarded with a fallback).
         Declared anyway because "works standalone" undersells it: without
         WAILA installed, IW's own HUD panels lose their left-edge anchor
         point and fall back to a fixed corner, and there's no live world
         inspector to pair with the tyre/foliage mechanics at all - the
         intended experience is genuinely the two together, not IW alone. -->
    <dependencies>
        <dependency>FS25_whatAmILookingAt</dependency>
    </dependencies>

    <extraSourceFiles>
        <sourceFile filename="scripts/UIHelper.lua" />
        <sourceFile filename="scripts/IWConfig.lua" />
        <sourceFile filename="scripts/IWSettingsUI.lua" />
        <sourceFile filename="scripts/IWFoliagePalette.lua" />
        <sourceFile filename="scripts/ImmersiveWeathering.lua" />
    </extraSourceFiles>

    <actions>
        <!-- Restored for the next round of testing - the underlying
             functions (placeFoliageTestRig, placeFoliageAreaFill) and
             their key-press handlers were never removed, just unwired. -->
        <action name="IW_PLACE_TEST_RIG" axisType="HALF"/>
        <action name="IW_FILL_AREA" axisType="HALF"/>
        <action name="IW_WEATHER_CROSSHAIR" axisType="HALF"/>
        <action name="IW_RUN_SWEEP" axisType="HALF"/>
        <!-- IW_TOGGLE_SAMPLE_COUNT, IW_CYCLE_WITHER_CHANCE,
             IW_TOGGLE_PAINT_BIAS, IW_SWAP_DIRT_GRAVEL and IW_SOW_GRASS
             retired the same way as IW_PLACE_TEST_RIG/IW_FILL_AREA above -
             sample count/wither chance/paint bias now live on the
             Settings page instead of a cycle key; swap/sow are
             superseded by automatic mechanics (material drift, the
             seeder feature) that do the same job without a manual key.
             No category attribute: engine's own ONFOOT/VEHICLE context
             switch can't silently deactivate these out from under us -
             see the earlier note in the Lua about the flaky per-vehicle
             registration attempt that was fully reverted. No AI-exclude
             toggle - AI-driven vehicles are unconditionally excluded from
             tyre effects in the Lua, player-only by design, not an
             option. -->
        <action name="IW_TOGGLE_TYRE_EFFECTS" axisType="HALF"/>
    </actions>

    <inputBinding>
        <!-- R itself is a hot letter in the base game's own vehicle scheme -
             Shift+R ("Start Loading") AND Ctrl+Shift+R ("Collection Mode")
             are BOTH already real pallet/bale-truck bindings, confirmed the
             hard way twice in a row. Switched letter entirely rather than
             stacking more modifiers onto R - K, avoiding the R/O/U/P
             cluster already known bad from earlier tonight's keybind
             collisions. -->
        <actionBinding action="IW_PLACE_TEST_RIG">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_lctrl KEY_k" index="1" />
        </actionBinding>
        <actionBinding action="IW_FILL_AREA">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_f" index="1" />
        </actionBinding>
        <actionBinding action="IW_WEATHER_CROSSHAIR">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_h" index="1" />
        </actionBinding>
        <actionBinding action="IW_RUN_SWEEP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_n" index="1" />
        </actionBinding>
        <actionBinding action="IW_TOGGLE_TYRE_EFFECTS">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_t" index="1" />
        </actionBinding>
    </inputBinding>

    <l10n>
         <text name="input_IW_PLACE_TEST_RIG">
            <en>Place foliage test rig</en>
        </text>
         <text name="input_IW_FILL_AREA">
            <en>Fill area (debug)</en>
        </text>
         <text name="input_IW_WEATHER_CROSSHAIR">
            <en>Weather Target</en>
        </text>
         <text name="input_IW_RUN_SWEEP">
            <en>Weathering Sweep</en>
        </text>
         <text name="input_IW_TOGGLE_TYRE_EFFECTS">
            <en>Tyre withering</en>
        </text>

        <!-- UIHelper.createControlsDynamically requires a _title/_info
             pair per control (id = prefix .. name), plus one _title for
             the section header itself. -->
        <text name="iw_setting_title">
            <en>Immersive Weathering</en>
        </text>
        <text name="iw_tyreWitherLevelIndex_title">
            <en>Tyre withering chance</en>
        </text>
        <text name="iw_tyreWitherLevelIndex_info">
            <en>How often grass converts to dirt/gravel under tyre contact.</en>
        </text>
        <text name="iw_tyrePaintPaletteIndex_title">
            <en>Tyre withering material bias</en>
        </text>
        <text name="iw_tyrePaintPaletteIndex_info">
            <en>Which material fresh conversions lean toward.</en>
        </text>
        <text name="iw_sweepSampleCountIndex_title">
            <en>Nightly sweep sample count</en>
        </text>
        <text name="iw_sweepSampleCountIndex_info">
            <en>How many points the nightly weathering sweep samples. Higher covers more ground per sweep but costs more per run.</en>
        </text>

        <!-- Choice-control value labels - one per entry in
             TYRE_WITHER_LEVEL_LABELS/TYRE_PAINT_PALETTE_LABELS/
             SWEEP_SAMPLE_COUNT_LABELS, same order. -->
        <text name="iw_wither_pct_0"><en>0%</en></text>
        <text name="iw_wither_pct_20"><en>20%</en></text>
        <text name="iw_wither_pct_40"><en>40%</en></text>
        <text name="iw_wither_pct_60"><en>60%</en></text>
        <text name="iw_wither_pct_80"><en>80%</en></text>
        <text name="iw_wither_pct_100"><en>100%</en></text>
        <text name="iw_material_dirt"><en>Dirt-leaning</en></text>
        <text name="iw_material_gravel"><en>Gravel-leaning</en></text>
        <text name="iw_samples_1000"><en>1000</en></text>
        <text name="iw_samples_2000"><en>2000</en></text>
        <text name="iw_samples_4000"><en>4000</en></text>
        <text name="iw_samples_6000"><en>6000</en></text>
        <text name="iw_samples_8000"><en>8000</en></text>
        <text name="iw_samples_10000"><en>10000</en></text>
     </l10n>
</modDesc>
