<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="93">
    <author>YourName</author>
    <version>1.0.0.0</version>
    <title>
        <en>Immersive Weathering</en>
    </title>
    <description>
        <en>Adds realistic weed growth to gravel plots overnight.</en>
    </description>
    <iconFilename>icon_immersive_weathering.dds</iconFilename>
    <multiplayer supported="true"/>

    <extraSourceFiles>
        <sourceFile filename="scripts/ImmersiveWeathering.lua" />
    </extraSourceFiles>

    <actions>
        <action name="IMMERSIVE_WEATHERING_DEBUG" axisType="HALF" category="ONFOOT"/>
        <action name="IMMERSIVE_WEATHERING_DEBUG2" axisType="HALF" category="ONFOOT"/>
        <action name="IMMERSIVE_WEATHERING_DEBUG3" axisType="HALF" category="ONFOOT"/>
        <action name="IMMERSIVE_WEATHERING_DEBUG4" axisType="HALF" category="ONFOOT"/>
    </actions>

    <inputBinding>
        <actionBinding action="IMMERSIVE_WEATHERING_DEBUG">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_g" index="1" />
        </actionBinding>
        <actionBinding action="IMMERSIVE_WEATHERING_DEBUG2">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_h" index="1" />
        </actionBinding>
        <actionBinding action="IMMERSIVE_WEATHERING_DEBUG3">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_n" index="1" />
        </actionBinding>
        <actionBinding action="IMMERSIVE_WEATHERING_DEBUG4">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_f" index="1" />
        </actionBinding>
    </inputBinding>

    <l10n>
         <text name="input_IMMERSIVE_WEATHERING_DEBUG">
            <en>Place foliage test rig</en>
        </text>
         <text name="input_IMMERSIVE_WEATHERING_DEBUG2">
            <en>Weather what I'm looking at</en>
        </text>
         <text name="input_IMMERSIVE_WEATHERING_DEBUG3">
            <en>Run weathering sweep</en>
        </text>
         <text name="input_IMMERSIVE_WEATHERING_DEBUG4">
            <en>Fill 3x3m area with grass</en>
        </text>
     </l10n>
</modDesc>
