<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="93">
    <author>YourName</author>
    <version>1.0.0.0</version>
    <title>
        <en>Immersive Weathering</en>
    </title>
    <description>
        <en>Adds realistic weed growth to gravel plots overnight.</en>
    </description>
    <iconFilename>icon_immersive_weathering.dds</iconFilename>
    <multiplayer supported="true"/>

    <extraSourceFiles>
        <sourceFile filename="scripts/ImmersiveWeathering.lua" />
    </extraSourceFiles>

    <actions>
        <action name="IMMERSIVE_WEATHERING_DEBUG" axisType="HALF" category="PLAYER_ON_FOOT"/>
    </actions>

    <inputBinding>
        <actionBinding action="IMMERSIVE_WEATHERING_DEBUG">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_j" index="1" />
        </actionBinding>
    </inputBinding>

    <l10n>
        <text name="input_IMMERSIVE_WEATHERING_DEBUG">
            <en>Immersive Weathering: Force Grass Spawning</en>
        </text>
    </l10n>
</modDesc>
